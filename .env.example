# Host ports for VectorForge's local Docker Compose deployment.
# Change either value if another local application already uses the port.
VECTORFORGE_WEB_PORT=5174
VECTORFORGE_API_PORT=8001
# Host-run API/tests; Docker Compose overrides this with its private-network URL.
VECTORFORGE_DATABASE_URL=postgresql+psycopg://vectorforge@localhost:5432/vectorforge
POSTGRES_PASSWORD=
